# Copiar a .env y ajustar. NUNCA subir .env al repositorio.
# Todas las variables de la aplicación llevan el prefijo SX_ (ver backend/src/sapextract/core/config.py).

# Entorno: dev | test | qa | prd
SX_ENVIRONMENT=dev

# Base de metadatos (en docker compose se sobrescribe para apuntar al servicio "db")
SX_DATABASE_URL=postgresql+psycopg://sapextract:sapextract@localhost:5432/sapextract

# Clave maestra para cifrar credenciales (obligatoria en QA/PRD).
# Generar con:  cd backend && uv run sapextract generate-master-key
SX_MASTER_KEY=
SX_MASTER_KEY_ID=k1
# Claves anteriores durante una rotación (JSON):  SX_PREVIOUS_MASTER_KEYS={"k0":"..."}

# Logs
SX_LOG_LEVEL=INFO
SX_LOG_JSON=false

# API
SX_DOCS_ENABLED=true
# Proxies inversos de confianza (IP o CIDR, JSON). Solo de ellos se acepta X-Forwarded-For;
# por defecto ["127.0.0.1"]. En docker compose, la red del contenedor del proxy.
# SX_TRUSTED_PROXIES=["10.0.0.0/24"]
# Orígenes permitidos para CORS (solo si el frontend se sirve desde otro dominio), JSON:
# SX_CORS_ORIGINS=["https://sapextract.empresa.local"]

# Identidad y sesiones (plan 02). Valores por defecto entre paréntesis.
# Administrador inicial: lo crea `sapextract db upgrade` si la base no tiene usuarios.
# La contraseña es TEMPORAL (se cambia en el primer acceso) y debe cumplir la política.
# SX_BOOTSTRAP_ADMIN_USER=admin
# SX_BOOTSTRAP_ADMIN_PASSWORD=
# SX_SESSION_IDLE_MINUTES=30            # cierre por inactividad
# SX_SESSION_ABSOLUTE_HOURS=12          # duración máxima de una sesión
# SX_SESSION_COOKIE_SECURE=             # vacío = solo HTTPS salvo en dev/test
# SX_LOGIN_MAX_ATTEMPTS=5               # intentos antes del bloqueo temporal
# SX_LOGIN_LOCKOUT_BASE_MINUTES=5       # se duplica con cada fallo adicional
# SX_AUTH_RATE_LIMIT_PER_MINUTE=20      # por IP y endpoint de /auth
# SX_MFA_REQUIRED_FOR_ADMINS=           # vacío = obligatorio en QA/PRD
# SX_LOCAL_LOGIN_ENABLED_FOR=all        # all | break_glass_only
# SX_PASSWORD_MIN_LENGTH=12
# SX_PASSWORD_HISTORY_SIZE=5
# SX_PASSWORD_DENYLIST_FILE=            # lista adicional de contraseñas prohibidas (una por línea)
# URL pública de la plataforma; de ella sale la URI de redirección de Entra ID (https fuera de dev).
# SX_PUBLIC_URL=https://sapextract.empresa.local
# Servidor de Entra ID. Solo se cambia en pruebas (Entra simulado) o nubes soberanas.
# SX_ENTRA_AUTHORITY_URL=https://login.microsoftonline.com

# Conexiones SAP (plan 04)
# SX_SAP_CATALOG_TTL_MINUTES=60         # vigencia de la caché del catálogo de Gateway
# Hosts SAP, proxies y servidores de tokens permitidos (JSON): sufijos DNS o redes CIDR.
# Vacío = cualquiera salvo 169.254.0.0/16 (y loopback fuera de dev/test). OBLIGATORIA en PRD.
# SX_SAP_ALLOWED_HOSTS=["empresa.local", "10.20.0.0/16"]

# Destinos (plan 07)
# Hosts de destino permitidos (JSON), p. ej. Snowflake. OBLIGATORIA en PRD.
# SX_DEST_ALLOWED_HOSTS=["snowflakecomputing.com"]
# Carpetas raíz donde se pueden escribir destinos CSV (JSON). Vacío = sin destinos CSV.
# SX_CSV_ROOTS=["/data/csv"]

# Solo pruebas: cuenta Snowflake para la batería de conformidad (tests/contract).
# Defínalas en su shell o en un archivo ignorado por git; nunca las suba al repositorio.
# SX_TEST_SNOWFLAKE_ACCOUNT=xy12345.east-us-2.azure
# SX_TEST_SNOWFLAKE_USER=  SX_TEST_SNOWFLAKE_ROLE=  SX_TEST_SNOWFLAKE_WAREHOUSE=
# SX_TEST_SNOWFLAKE_DATABASE=  SX_TEST_SNOWFLAKE_SCHEMA=
# SX_TEST_SNOWFLAKE_PRIVATE_KEY_PATH=   # ruta a la clave privada PEM (fuera del repo)
# SX_TEST_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Procesos de fondo
SX_SCHEDULER_TICK_SECONDS=5
SX_WORKER_POLL_SECONDS=5
# Pools de los que este worker toma runs (reserve uno para PRD) y latido de un run en curso.
# SX_WORKER_POOLS=["default"]
# SX_WORKER_HEARTBEAT_SECONDS=15
# Sin latido durante este tiempo, el scheduler da el intento por caído (mínimo, el doble del latido).
# SX_RUN_STALE_SECONDS=90
# Retraso a partir del cual un disparo programado cuenta como atrasado.
# SX_SCHEDULER_MISFIRE_GRACE_SECONDS=60
SX_SPOOL_DIR=spool
# Motor (plan 06): spool, timeout por página SAP y margen de la marca de agua
SX_SPOOL_KEEP_ON_SUCCESS=false
SX_PAGE_TIMEOUT_SECONDS=300
SX_WATERMARK_SAFETY_LAG_SECONDS=120
# «Probar pipeline» (plan 08): filas de la muestra y tiempo máximo de su lectura en SAP.
# SX_TEST_RUN_ROWS=100
# SX_TEST_RUN_TIMEOUT_SECONDS=60
# Días que se conserva el log de ejecución; el scheduler borra las particiones vencidas (plan 03 §4).
# SX_RUN_LOG_RETENTION_DAYS=90

# Monitoreo y alertas (plan 09)
# SX_ALERT_EVAL_SECONDS=20              # cada cuánto evalúa las reglas el scheduler
# SX_ALERT_COOLDOWN_MINUTES=10          # una alerta que se repite antes no vuelve a avisar
# Hosts permitidos para webhooks de Teams y genéricos (JSON). OBLIGATORIA en PRD.
# SX_ALERT_ALLOWED_HOSTS=["empresa.webhook.office.com", "itsm.empresa.local"]
# Correo de los avisos (SMTP con STARTTLS)
# SX_SMTP_HOST=smtp.empresa.local
# SX_SMTP_PORT=587
# SX_SMTP_STARTTLS=true
# SX_SMTP_USER=
# SX_SMTP_PASSWORD=
# SX_SMTP_FROM=sapextract@empresa.local
# Token para /api/v1/metrics (Prometheus, cabecera Authorization: Bearer). Vacío = sin métricas.
# SX_METRICS_TOKEN=

# Solo desarrollo: contraseña del SQL Server de pruebas (perfil "mssql" de docker compose)
# SX_DEV_MSSQL_SA_PASSWORD=
