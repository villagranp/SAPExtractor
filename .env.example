# Copiar a .env y ajustar. NUNCA subir .env al repositorio.
# Todas las variables de la aplicación llevan el prefijo SX_ (ver backend/src/sapextract/core/config.py).

# Entorno: dev | test | qa | prd
SX_ENVIRONMENT=dev

# Base de metadatos (en docker compose se sobrescribe para apuntar al servicio "db")
SX_DATABASE_URL=postgresql+psycopg://sapextract:sapextract@localhost:5432/sapextract

# Clave maestra para cifrar credenciales (obligatoria en QA/PRD).
# Generar con:  cd backend && uv run sapextract generate-master-key
SX_MASTER_KEY=
SX_MASTER_KEY_ID=k1
# Claves anteriores durante una rotación (JSON):  SX_PREVIOUS_MASTER_KEYS={"k0":"..."}

# Logs
SX_LOG_LEVEL=INFO
SX_LOG_JSON=false

# API
SX_DOCS_ENABLED=true
# Orígenes permitidos para CORS (solo si el frontend se sirve desde otro dominio), JSON:
# SX_CORS_ORIGINS=["https://sapextract.empresa.local"]

# Procesos de fondo
SX_SCHEDULER_TICK_SECONDS=5
SX_WORKER_POLL_SECONDS=5
SX_SPOOL_DIR=spool

# Solo desarrollo: contraseña del SQL Server de pruebas (perfil "mssql" de docker compose)
# SX_DEV_MSSQL_SA_PASSWORD=
