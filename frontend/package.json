{
  "name": "sapextract-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "i18next": "^27.1.5",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
